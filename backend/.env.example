# ==============================================================================
# BIẾN MÔI TRƯỜNG BACKEND HOMESTAY (Node.js + Express + Prisma)
# Hướng dẫn: Sao chép file này thành .env và điền thông tin phù hợp với máy của bạn.
# LƯU Ý: Tuyệt đối KHÔNG commit file .env chứa mật khẩu thật lên GitHub!
# ==============================================================================

# 1. Chuỗi kết nối cơ sở dữ liệu PostgreSQL
# Cú pháp: postgresql://<username>:<password>@<host>:<port>/<database_name>?schema=public
# Ví dụ: postgresql://postgres:123456@localhost:5432/ptda_homestay
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/ptda_homestay"

# 2. Khóa bí mật ký mã hóa JWT token (Auth / Owner / Admin)
# Khuyến nghị: Chuỗi ký tự ngẫu nhiên, độ dài tối thiểu 32 ký tự
JWT_SECRET="ptda_homestay_secret_jwt_key_2024_demo_learning_group16"

# 3. Cổng chạy của máy chủ Express Backend (Mặc định: 3000)
PORT=3000

